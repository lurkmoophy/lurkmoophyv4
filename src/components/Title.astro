---
const { title, as: Tag = 'h3', description } = Astro.props;
---
<Tag class="title" id={`title-${title.toLowerCase().replace(/\s+/g, '-')}`}>
    <span class="title-track">
        <span class="title-marquee" aria-hidden="true">&lt;{title}&gt;</span>
        <span class="title-text">&lt;{title}&gt;</span>
        <span class="title-marquee" aria-hidden="true">&lt;{title}&gt; &lt;{title}&gt; &lt;{title}&gt; </span>
    </span>
    {description && <p class="description">{description}</p>}
</Tag>

<style is:global>
    .title {
        border-top: 7px solid var(--black);
        border-bottom: 7px solid var(--black);
        font-family: 'Gideon Roman', serif;
        padding: 0.15em 0 0.15em 3vw;
        margin: 0 0 0.5em;
        font-size: clamp(3rem, 0.75rem + 10vw, 5rem);
        font-weight: 400;
        text-transform: uppercase;
        text-align: left;
        overflow: hidden;
        text-wrap: nowrap;
        filter: blur(0.7px);
    }
    .title-track {
        display: block;
        will-change: transform;
    }
    .title-marquee {
        color: var(--grey);
        opacity: 0.2;
    }
    .description {
        font-size: 1.25rem;
        font-style: italic;
        margin-bottom: 1em;
        text-transform: none;
        font-style: normal;
        font-family: 'Alegreya Sans', sans-serif;
        padding-left: 5%;
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const titleElements = document.querySelectorAll('.title');
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        const MAX_SHIFT_PX = 80;
        const TITLE_GAP_PX = 20;
        // Lower = longer ease after scroll stops (~1.5–2s settle)
        const EASE = 0.045;
        const SNAP_PX = 0.1;

        const tracks = [...titleElements].flatMap((titleEl) => {
            const track = titleEl.querySelector('.title-track');
            if (!(track instanceof HTMLElement)) return [];
            return [{ titleEl, track, current: 0, target: 0, ready: false }];
        });

        function getBaseOffset(titleEl) {
            const titleText = titleEl.querySelector('.title-text');
            if (!(titleText instanceof HTMLElement)) return TITLE_GAP_PX;
            return titleText.getBoundingClientRect().width + TITLE_GAP_PX;
        }

        function getScrollProgress(titleEl) {
            const rect = titleEl.getBoundingClientRect();
            const viewportHeight = window.innerHeight;
            const titleTop = rect.top;
            const startPoint = viewportHeight;
            const endPoint = 0;

            let progress = 0;
            if (titleTop < startPoint && titleTop > endPoint) {
                progress = 1 - ((titleTop - endPoint) / (startPoint - endPoint));
            } else if (titleTop <= endPoint) {
                progress = 1;
            }

            progress = Math.max(0, Math.min(1, progress));
            // Ease-out curve on the scroll mapping itself
            return 1 - Math.pow(1 - progress, 3);
        }

        function updateTargets() {
            tracks.forEach((item) => {
                const baseOffset = getBaseOffset(item.titleEl);
                const shift = prefersReducedMotion ? 0 : MAX_SHIFT_PX * getScrollProgress(item.titleEl);
                item.target = -baseOffset + shift;

                if (!item.ready) {
                    item.current = item.target;
                    item.ready = true;
                    item.track.style.transform = `translateX(${item.current}px)`;
                }
            });
        }

        function tick() {
            tracks.forEach((item) => {
                const delta = item.target - item.current;
                if (Math.abs(delta) > SNAP_PX) {
                    item.current += delta * EASE;
                } else {
                    item.current = item.target;
                }
                item.track.style.transform = `translateX(${item.current}px)`;
            });
            requestAnimationFrame(tick);
        }

        updateTargets();
        window.addEventListener('scroll', updateTargets, { passive: true });
        window.addEventListener('resize', updateTargets);

        if (!prefersReducedMotion) {
            requestAnimationFrame(tick);
        }
    });
</script>
