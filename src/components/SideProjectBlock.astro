---
interface Props {
	title: string;
	backgroundTitle?: string;
	description: string;
	href: string;
	linkLabel?: string;
	class?: string;
	external?: boolean;
}

const {
	title,
	backgroundTitle = title,
	description,
	href,
	linkLabel = 'Check it out',
	class: className = '',
	external = false,
} = Astro.props;
---

<div class:list={['side__project-individual', className]}>
	<div class="side__project-individual-image">
		<slot name="image" />
	</div>
	<div class="side__project-individual-title-background">
		<h2>{backgroundTitle}</h2>
	</div>
	<div class="side__project-individual-content">
		<h2 class="side__project-individual-title">{title}</h2>
		<p class="side__project-individual-description">{description}</p>
		<div class="side__project-individual-link">
			<a
				href={href}
				target={external ? '_blank' : undefined}
				rel={external ? 'noopener noreferrer' : undefined}
			>
				{linkLabel}
			</a>
		</div>
	</div>
</div>

<style is:global>
	.side__project-container {
		width: 95%;
		max-width: 1600px;
		margin: 0 auto 1rem;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: 1rem;
		row-gap: 0.5rem;
	}

	.side__project-individual {
		position: relative;
		grid-column: 1 / 13;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		border: 3px solid color-mix(in srgb, var(--grey) 30%, transparent);
		border-radius: 1rem;
		padding: 2rem 3rem;
		background-color: color-mix(in srgb, var(--grey) 30%, transparent);
		overflow: hidden;
		transition: all 0.3s ease;
		container-type: inline-size;
		min-height: 14rem;
	}

	.side__project-filler {
		border: 3px solid var(--coral);
		background-color: color-mix(in srgb, var(--coral) 30%, transparent);
		border-radius: 1rem;
	}

	.side__project-filler.filler-left {
		grid-column: span 2;
	}

	.side__project-filler.filler-right {
		grid-column: auto;
		border-color: var(--blue);
		background-color: color-mix(in srgb, var(--blue) 30%, transparent);
	}

	.side__project-filler.filler-right-more {
		grid-column: span 2;
		grid-row: span 2;
		border-color: var(--green);
		background-color: color-mix(in srgb, var(--green) 30%, transparent);
	}

	.side__project-individual.grid-nudge-right {
		grid-column: 3 / 13;
	}

	.side__project-individual.grid-nudge-left {
		grid-column: 1 / 12;
	}

	.side__project-individual.grid-half {
		grid-column: span 6;
	}

	.side__project-individual.grid-nudge-left-more {
		grid-column: 1 / 11;
	}

	.side__project-individual.grid-center {
		grid-column: 3 / 11;
	}

	@media (max-width: 1000px) {
		.side__project-filler {
			display: none;
		}

		.side__project-individual,
		.side__project-individual.grid-nudge-right,
		.side__project-individual.grid-nudge-left,
		.side__project-individual.grid-half,
		.side__project-individual.grid-nudge-left-more,
		.side__project-individual.grid-center {
			grid-column: 1 / 13;
		}
	}

	.side__project-individual-image {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: transform 0.8s var(--easeOutCubic);
		pointer-events: none;
	}

	.side__project-individual-image svg,
	.side__project-individual-image img {
		height: 150px;
		width: auto;
		max-width: 70%;
		object-fit: contain;
		border-radius: 0.5rem;
	}

	.side__project-individual-image svg {
		fill: var(--black);
	}

	.side__project-individual-title-background {
		position: absolute;
		width: 100%;
		height: 100%;
		top: 0;
		left: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		transition: opacity 0.4s ease-in, visibility 0.4s ease-in;
		pointer-events: none;
	}

	.side__project-individual-title-background h2 {
		font-family: 'Gideon Roman', serif;
		padding: 0;
		margin: 0;
		font-size: clamp(4rem, 0.75rem + 10vw, 11rem);
		text-align: center;
		line-height: 0.7;
		font-weight: 400;
		filter: blur(0.7px);
		color: color-mix(in srgb, var(--grey) 40%, transparent);
		z-index: -1;
	}

	.side__project-individual-content {
		opacity: 0;
		visibility: hidden;
		transition: opacity 0.4s ease-in, visibility 0.4s ease-in, transform 0.2s ease-in;
		transform: translateX(-20%);
		transition-delay: 0.4s;
		justify-self: flex-start;
		width: 100%;
	}

	.side__project-individual-title {
		font-family: 'Gideon Roman', serif;
		line-height: 0.8;
		max-width: 30rem;
		font-size: clamp(2rem, 0.75rem + 5vw, 3rem);
	}

	.side__project-individual-description {
		font-size: 1rem;
		max-width: 30rem;
	}

	.side__project-individual-link {
		margin-top: 1rem;
		text-transform: uppercase;
		font-size: 1rem;
		letter-spacing: 0.1em;
	}

	.side__project-individual-link:after {
		content: '→';
		font-size: 1rem;
		margin-left: 0;
		display: inline-block;
		transition: transform 0.3s ease-in;
	}

	.side__project-individual:hover {
		background-color: var(--white);
		border-color: var(--black);
	}

	.side__project-individual:hover .side__project-individual-title-background {
		animation: sideProjectSlideOut 1s var(--easeOutCubic);
		opacity: 0;
		visibility: hidden;
	}

	.side__project-individual:hover .side__project-individual-content {
		opacity: 1;
		visibility: visible;
		transform: translateX(0);
	}

	.side__project-individual:hover .side__project-individual-image {
		transform: translateX(40%);
		opacity: 0.3;
	}

	.side__project-individual:focus-within {
		background-color: var(--white);
		border-color: var(--black);
	}

	.side__project-individual:focus-within .side__project-individual-title-background {
		opacity: 0;
		visibility: hidden;
	}

	.side__project-individual:focus-within .side__project-individual-content {
		opacity: 1;
		visibility: visible;
		transform: translateX(0);
	}

	@media (hover: none) {
		.side__project-individual-content {
			opacity: 1;
			visibility: visible;
			transform: none;
			transition: none;
		}

		.side__project-individual-title-background {
			opacity: 0.35;
		}

		.side__project-individual-image {
			opacity: 0.2;
		}
	}

	@container (width < 700px) {
		.side__project-individual:hover .side__project-individual-image {
			transform: translateX(35%) translateY(-30%) scale(0.5);
		}
	}

	@keyframes sideProjectSlideOut {
		0% {
			transform: translateX(0);
		}
		100% {
			transform: translateX(-80%);
		}
	}
</style>
